# Never commit .env.local. Only NEXT_PUBLIC_* values enter the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false until content, policies, credentials, and live QA are approved.
NEXT_PUBLIC_LAUNCH_READY=false
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
MANAGEMENT_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_SALT=
CRON_SECRET=
# Optional: disposable dedicated PostgreSQL database for multi-connection tests.
TEST_DATABASE_URL=
# Set true only when running test:db against a new disposable database/cluster.
LOVE_ALLOW_DISPOSABLE_DB=false
